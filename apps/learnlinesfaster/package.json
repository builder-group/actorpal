	"scripts": {
		"build": "pnpm typecheck && react-router build",
		"clean": "shx rm -rf build && shx rm -rf .react-router && shx rm -rf .turbo && shx rm -rf node_modules",
		"format": "prettier --write \"**/*.{ts,tsx,md,json,js,jsx}\"",
		"install:clean": "pnpm run clean && pnpm install",
		"lint": "eslint .",
		"start": "react-router-serve ./build/server/index.js",
		"start:dev": "react-router dev",
		"test": "vitest run",
		"typecheck": "react-router typegen && tsc --noEmit",
		"update:latest": "pnpm update --latest '!typescript' '!react-router' '!@react-router/*'"
	},
	"dependencies": {
		"@react-router/fs-routes": "^7.18.2",
