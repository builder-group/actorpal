{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "isshin",
	"version": "0.0.1",
	"identifier": "com.buildergroup.isshin",
	"build": {
		"beforeDevCommand": "pnpm pre:dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm pre:build",
		"frontendDist": "../build/client"
	},
	"app": {
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
