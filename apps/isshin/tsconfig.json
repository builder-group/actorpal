{
	"extends": "@blgc/config/typescript/react-internal",
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "dom", "dom.iterable"],
		"baseUrl": ".",
		"types": ["@react-router/node", "vite/client"],
		"rootDirs": [".", "./.react-router/types"],
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["env.d.ts", "**/*.ts", "**/*.tsx", ".react-router/types/**/*"],
	"exclude": ["node_modules"]
}