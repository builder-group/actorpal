{
	"name": "@repo/kairos",
	"version": "0.0.4",
	"private": true,
	"description": "",
	"keywords": [],
	"bugs": {
		"url": "https://github.com/builder-group/lab/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/builder-group/lab.git"
	},
	"license": "AGPL-3.0-or-later",
	"author": "@bennobuilder",
	"main": "expo-router/entry",
	"scripts": {
		"build": "pnpm typecheck && expo export --platform ios --output-dir dist",
		"clean": "shx rm -rf build && shx rm -rf dist && shx rm -rf .expo && shx rm -rf .turbo && shx rm -rf node_modules",
		"expo:doctor": "pnpm dlx expo-doctor@latest",
		"format": "prettier --write \"**/*.{ts,tsx,md,json,js,jsx}\"",
		"install:clean": "pnpm run clean && pnpm install",
		"ios:build:cloud": "pnpm dlx eas-cli@latest build --platform ios --profile production",
		"ios:build:local": "bash ./scripts/ios-eas.sh build",
		"ios:submit:cloud": "pnpm dlx eas-cli@latest submit --platform ios --profile production --latest",
		"ios:submit:local": "bash ./scripts/ios-eas.sh submit",
		"lint": "eslint .",
		"start:dev": "expo start --dev-client --lan",
		"start:dev:ios": "expo start --dev-client --ios --lan",
		"start:dev:ios:prebuild": "expo run:ios --device",
		"test": "echo \"🧪 No tests defined yet.\"",
		"typecheck": "tsc --noEmit",
		"update:latest": "bash ./scripts/update-latest.sh",
		"version:bump": "bash ./scripts/version.sh"
	},
	"dependencies": {
		"@expo/ui": "57.0.10",
		"@expo/vector-icons": "^15.0.2",
		"@react-native-async-storage/async-storage": "^2.2.0",
		"clsx": "^2.1.1",
		"expo": "~57.0.12",
		"expo-blur": "~57.0.2",
		"expo-constants": "~57.0.10",
		"expo-dev-client": "~57.0.11",
		"expo-device": "~57.0.1",
		"expo-font": "~57.0.1",
		"expo-glass-effect": "~57.0.1",
		"expo-haptics": "~57.0.1",
		"expo-image": "~57.0.2",
		"expo-keep-awake": "~57.0.1",
		"expo-linear-gradient": "~57.0.1",
		"expo-linking": "~57.0.5",
		"expo-router": "~57.0.12",
		"expo-splash-screen": "~57.0.6",
		"expo-status-bar": "~57.0.1",
		"expo-symbols": "~57.0.2",
		"expo-system-ui": "~57.0.2",
		"expo-web-browser": "~57.0.2",
		"feature-react": "^0.1.0",
		"feature-state": "^0.1.0",
		"nativewind": "5.0.0-preview.2",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-native": "0.86.2",
		"react-native-css": "^3.0.7",
		"react-native-gesture-handler": "~2.32.0",
		"react-native-reanimated": "4.5.1",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-screens": "~4.26.2",
		"react-native-svg": "15.15.4",
		"react-native-web": "~0.21.0",
		"react-native-worklets": "0.10.1",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@types/react": "~19.2.18",
		"postcss": "^8.5.26",
		"tailwindcss": "^4.3.3"
	}
}
