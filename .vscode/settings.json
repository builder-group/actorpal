{
	// Editor settings
	"editor.formatOnSave": true,
	"editor.formatOnPaste": false,
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "explicit"
	},
	"editor.wordWrap": "on",

	// Search settings
	"search.exclude": {
		"**/node_modules": true,
		"**/dist": true,
		"**/.next": true,
		"**/_deprecated": true
	},

	// File associations
	"files.associations": {
		"*.scss": "postcss",
		"*.ts": "typescript",
		"*.tsconfig.json": "jsonc" // Allows comments in tsconfig.json
	},

	// File nesting in explorer
	"explorer.fileNesting.enabled": true,
	"explorer.fileNesting.patterns": {
		"*.ts": "${capture}.js, ${capture}.test.ts, ${capture}.md",
		"*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts, ${capture}.test.js, ${capture}.md",
		"*.jsx": "${capture}.js, ${capture}.md, ${capture}.module.css",
		"*.tsx": "${capture}.ts, ${capture}.stories.tsx, ${capture}.md, ${capture}.module.css",
		".npmrc": ".nvmrc, .yarnrc.yml",
		".gitignore": ".eslintignore, .prettierignore, .dockerignore",
		"README.md": "CONTRIBUTING.md, CODE_OF_CONDUCT.md",
		".eslintrc.js": ".eslintcache",
		"package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, pnpm-workspace.yaml, .pnp.cjs, .pnp.loader.mjs",
		"tsconfig.json": "tsconfig.*.json"
	},

	// ESLint settings
	"eslint.workingDirectories": [
		{
			"mode": "auto"
		}
	],

	// Tailwind CSS settings
	"tailwindCSS.experimental.classRegex": [
		["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
		["cx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
	],

	// https://github.com/foxundermoon/vs-shell-format/issues/62
	"[dockerfile]": {
		"editor.formatOnSave": false
	},
	"shellformat.effectLanguages": [
		"shellscript"
		// ... excluding dockerfile
	],

	// Tauri settings
	"recommendations": ["tauri-apps.tauri-vscode", "rust-lang.rust-analyzer"],

	// Rust settings
	"[rust]": {
		"editor.defaultFormatter": "rust-lang.rust-analyzer"
	},
	"rust-analyzer.rename.allowExternalItems": true,
	"rust-analyzer.runnableEnv": {
		"ENV_ROOT_DIR": "${workspaceFolder}",
		"GENERATE_IMAGES": "true"
	},

	// XCode Settings
	"lldb.library": "/Applications/Xcode.app/Contents/SharedFrameworks/LLDB.framework/Versions/A/LLDB",
	"lldb.launch.expressions": "native"
}
