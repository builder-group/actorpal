{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "NoDox",
	"identifier": "com.buildergroup.nodox.dev",
	"mainBinaryName": "NoDox - Development",
	"build": {
		"beforeDevCommand": "pnpm ui:start:dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm ui:build",
		"frontendDist": "../dist"
	},
	"app": {
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
