		"shx": "^0.4.0",
		"tsx": "^4.20.6",
		"turbo": "^2.6.0",
		"typescript": "^5.9.3",
		"vite": "^7.2.1",
		"vitest": "^4.0.7"
	},
	"packageManager": "pnpm@10.20.0",
	"engines": {
		"node": ">=24"
	}
